{
  "opencollection": "1.0.0",
  "info": {
    "name": "PartnerStack Customers Deals API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List deals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partnerstack.com/api/v2/deals",
            "params": [
              {
                "name": "min_created",
                "value": "",
                "type": "query"
              },
              {
                "name": "max_created",
                "value": "",
                "type": "query"
              },
              {
                "name": "min_updated",
                "value": "",
                "type": "query"
              },
              {
                "name": "max_updated",
                "value": "",
                "type": "query"
              },
              {
                "name": "group",
                "value": "",
                "type": "query"
              },
              {
                "name": "partner_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "customer_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of deals sorted by creation date."
        }
      ]
    }
  ],
  "bundled": true
}